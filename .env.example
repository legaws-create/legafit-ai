# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role is server-only. NEVER expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- OpenAI -----
OPENAI_API_KEY=sk-...
# Any chat-capable model you have access to. gpt-4o-mini is a cheap, capable default.
OPENAI_MODEL=gpt-4o-mini

# ----- Strava OAuth -----
# Create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret

# ----- App -----
# Used to build OAuth redirect URLs. Set to your Vercel URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
